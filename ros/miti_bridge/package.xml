<?xml version="1.0"?>
<package format="3">
  <name>miti_bridge</name>
  <version>0.1.0</version>
  <description>Serves a ROS 2 robot's topics, services, parameters and meshes to MITI over the MITI protocol, on libmiti. Replaces foxglove_bridge for MITI.</description>
  <maintainer email="thongpanchang.h@gmail.com">MITI Contributors</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/hiran-t/MITI-sdk</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>libmiti</depend>
  <depend>rclcpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>rcpputils</depend>
  <depend>rmw</depend>
  <depend>rosidl_typesupport_introspection_cpp</depend>
  <depend>rosgraph_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>std_msgs</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>std_srvs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
