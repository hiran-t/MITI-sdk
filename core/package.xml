<?xml version="1.0"?>
<package format="3">
  <name>libmiti</name>
  <version>0.1.2</version>
  <description>Serves MITI over WebSocket with the MITI protocol. Plain CMake, no ROS dependency; the package.xml lets colcon and rosdep build it in a ROS workspace.</description>
  <maintainer email="thongpanchang.h@gmail.com">MITI Contributors</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/hiran-t/MITI-sdk</url>

  <buildtool_depend>cmake</buildtool_depend>
  <buildtool_depend>pkg-config</buildtool_depend>
  <build_depend>boost</build_depend>
  <build_depend>nlohmann-json-dev</build_depend>
  <!-- The jpeg transform. Also needed where the static libmiti is linked. -->
  <depend>libturbojpeg</depend>
  <test_depend>gtest</test_depend>

  <export>
    <build_type>cmake</build_type>
  </export>
</package>
